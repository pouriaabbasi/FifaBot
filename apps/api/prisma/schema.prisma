generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// LeagueStatus: draft | active | finished
// StageFormat: round_robin | knockout
// StageStatus: pending | active | done
// MemberRole: owner | admin | player
// TeamStatus: incomplete | complete
// MatchStatus: pending | played
// NotificationType: result_confirmed

model User {
  telegramId    BigInt          @id
  username      String?
  firstName     String
  nickname      String?
  photoUrl      String?
  createdAt     DateTime        @default(now())

  loginUsername String?         @unique
  passwordHash  String?
  credentialsSentAt DateTime?

  ownedLeagues  League[]        @relation("LeagueOwner")
  memberships   LeagueMemberUser[]
  notifications Notification[]
}

model League {
  id          String       @id @default(uuid())
  name        String
  ownerId     BigInt
  owner       User         @relation("LeagueOwner", fields: [ownerId], references: [telegramId])
  status      String       @default("draft")
  isTwoStage  Boolean      @default(false)
  teamSize    Int          @default(1)
  inviteCode  String       @unique
  createdAt   DateTime     @default(now())

  stages      LeagueStage[]
  members     LeagueMember[]
}

model LeagueStage {
  id          String      @id @default(uuid())
  leagueId    String
  league      League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  order       Int
  format      String
  qualifyTopN Int?
  status      String      @default("pending")

  matches     Match[]

  @@unique([leagueId, order])
}

model LeagueMember {
  id         String     @id @default(uuid())
  leagueId   String
  league     League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  nickname   String?
  role       String     @default("player")
  status     String     @default("complete")
  joinedAt   DateTime   @default(now())

  users       LeagueMemberUser[]
  homeMatches Match[]            @relation("HomeMember")
  awayMatches Match[]            @relation("AwayMember")
}

model LeagueMemberUser {
  id       String       @id @default(uuid())
  memberId String
  member   LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  userId   BigInt
  user     User         @relation(fields: [userId], references: [telegramId])

  @@unique([memberId, userId])
}

model Match {
  id           String       @id @default(uuid())
  stageId      String
  stage        LeagueStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  homeMemberId String
  homeMember   LeagueMember @relation("HomeMember", fields: [homeMemberId], references: [id])
  awayMemberId String
  awayMember   LeagueMember @relation("AwayMember", fields: [awayMemberId], references: [id])
  round        Int?
  status       String       @default("pending")
  homeScore    Int?
  awayScore    Int?
  playedAt     DateTime?

  notifications Notification[]

  @@index([stageId, status])
}

model Notification {
  id        String    @id @default(uuid())
  userId    BigInt
  user      User      @relation(fields: [userId], references: [telegramId])
  type      String
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  delivered Boolean   @default(false)
  error     String?
  sentAt    DateTime  @default(now())

  @@unique([userId, matchId, type])
}
